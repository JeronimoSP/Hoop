rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function under5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function under20MB() {
      return request.resource.size < 20 * 1024 * 1024;
    }

    function under25MB() {
      return request.resource.size < 25 * 1024 * 1024;
    }

    function under100MB() {
      return request.resource.size < 100 * 1024 * 1024;
    }

    // Profile avatars: users/{userId}/profile/avatar.jpg
    match /users/{userId}/profile/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && isImage()
        && under5MB();
      allow delete: if isOwner(userId);
    }

    // Path: circles/{circleId}/uploads/{uid}/{postId}/{fileName}
    // Membership is enforced when writing the Firestore post.
    // Cover images (cover.jpg) are written by Cloud Functions (Admin SDK).
    match /circles/{circleId}/uploads/{userId}/{postId}/{fileName} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && (
          (isImage() && under5MB())
          || (isPdf() && under20MB())
          || (isAudio() && under5MB())
          || (isVideo() && under25MB())
        );
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    // Challenge master media (facilitator upload; membership checked in Firestore).
    match /circles/{circleId}/challenges/{challengeId}/master/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && ((isAudio() && under100MB()) || (isVideo() && under100MB()));
      allow update: if false;
      allow delete: if false;
    }

    // Quest session evidence — enrollmentId is `{challengeId}_{userId}`.
    match /circles/{circleId}/challenges/{challengeId}/enrollments/{enrollmentId}/sessions/{sessionId}/{kind}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && enrollmentId.matches('.*_' + request.auth.uid)
        && (
          (kind == 'image' && isImage() && under5MB())
          || (kind == 'audio' && isAudio() && under5MB())
        );
      allow update: if false;
      allow delete: if false;
    }
  }
}
