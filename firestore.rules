rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isPlatformAdmin() {
      return signedIn() && userDoc().isPlatformAdmin == true;
    }

    function selfPromoteEnabled() {
      return exists(/databases/$(database)/documents/appConfig/settings)
        && get(/databases/$(database)/documents/appConfig/settings).data.selfPromoteEnabled == true;
    }

    function membershipPath(circleId, userId) {
      return /databases/$(database)/documents/memberships/$(circleId + '_' + userId);
    }

    function isMember(circleId) {
      return signedIn() && exists(membershipPath(circleId, uid()));
    }

    function memberRole(circleId) {
      return get(membershipPath(circleId, uid())).data.role;
    }

    function isCircleAdmin(circleId) {
      return isMember(circleId) && memberRole(circleId) == 'admin';
    }

    match /appConfig/settings {
      allow read: if signedIn();
      // Bootstrap: first signed-in user may create the settings doc with promote open.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['selfPromoteEnabled'])
        && request.resource.data.selfPromoteEnabled == true;
      // Only platform admins may change settings (e.g. close self-promote).
      allow update: if isPlatformAdmin()
        && request.resource.data.keys().hasOnly(['selfPromoteEnabled'])
        && request.resource.data.selfPromoteEnabled is bool;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && uid() == userId
        && request.resource.data.isPlatformAdmin == false;
      allow update: if signedIn() && uid() == userId && (
        request.resource.data.isPlatformAdmin == resource.data.isPlatformAdmin
        || (
          selfPromoteEnabled()
          && resource.data.isPlatformAdmin == false
          && request.resource.data.isPlatformAdmin == true
        )
      );
      allow delete: if false;

      match /fcmTokens/{tokenId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    match /circles/{circleId} {
      allow read: if isMember(circleId);
      allow create: if isPlatformAdmin()
        && request.resource.data.createdBy == uid();
      allow update: if isCircleAdmin(circleId)
        || (
          isMember(circleId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastPost', 'updatedAt'])
        );
      allow delete: if false;

      match /posts/{postId} {
        allow read: if isMember(circleId);
        allow create: if isMember(circleId)
          && request.resource.data.authorId == uid()
          && (
            !(request.resource.data.type in ['instruction', 'resource'])
            || isCircleAdmin(circleId)
          );
        allow update, delete: if false;

        // One reaction doc per user (doc id = uid). Toggle = set or delete.
        match /reactions/{reactionUserId} {
          allow read: if isMember(circleId);
          allow create, update: if isMember(circleId)
            && reactionUserId == uid()
            && request.resource.data.userId == uid()
            && request.resource.data.emoji is string
            && request.resource.data.emoji.size() > 0
            && request.resource.data.emoji.size() <= 16;
          allow delete: if isMember(circleId) && reactionUserId == uid();
        }
      }

      match /challenges/{challengeId} {
        allow read: if isMember(circleId);
        allow create: if isCircleAdmin(circleId)
          && request.resource.data.createdBy == uid();
        allow update: if isCircleAdmin(circleId);
        allow delete: if false;
      }
    }

    match /challengeEnrollments/{enrollmentId} {
      // Allow get on missing docs so enroll can check "already enrolled"
      // without resource.data (null resource fails userId checks).
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/challengeEnrollments/$(enrollmentId))
        || resource.data.userId == uid()
        || isCircleAdmin(resource.data.circleId)
      );
      allow list: if signedIn() && (
        resource.data.userId == uid()
        || isCircleAdmin(resource.data.circleId)
      );
      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && isMember(request.resource.data.circleId);
      allow update: if signedIn()
        && resource.data.userId == uid()
        && request.resource.data.userId == uid();
      allow delete: if false;
    }

    match /challengeSessions/{sessionId} {
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/challengeSessions/$(sessionId))
        || resource.data.userId == uid()
        || isCircleAdmin(resource.data.circleId)
      );
      allow list: if signedIn() && (
        resource.data.userId == uid()
        || isCircleAdmin(resource.data.circleId)
      );
      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && isMember(request.resource.data.circleId);
      allow update: if signedIn()
        && resource.data.userId == uid()
        && request.resource.data.userId == uid();
      allow delete: if false;
    }

    match /memberships/{membershipId} {
      allow read: if signedIn() && (
        resource.data.userId == uid()
        || isCircleAdmin(resource.data.circleId)
      );
      allow create: if signedIn() && (
        isPlatformAdmin()
        || isCircleAdmin(request.resource.data.circleId)
      );
      // Member may clear/mark unread cursor on their own membership only.
      allow update: if signedIn()
        && resource.data.userId == uid()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.circleId == resource.data.circleId
        && request.resource.data.role == resource.data.role
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['unreadCount', 'lastOpenedAt']);
      allow delete: if isCircleAdmin(resource.data.circleId);
    }

    match /assignments/{assignmentId} {
      allow read: if isMember(resource.data.circleId);
      allow create: if isCircleAdmin(request.resource.data.circleId)
        && request.resource.data.createdBy == uid();
      allow update: if isCircleAdmin(resource.data.circleId);
      allow delete: if false;
    }

    match /objectives/{objectiveId} {
      function assignmentCircleId() {
        return get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.circleId;
      }
      function existingAssignmentCircleId() {
        return get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data.circleId;
      }

      allow read: if isMember(existingAssignmentCircleId());
      allow create: if isCircleAdmin(assignmentCircleId());
      allow update: if isCircleAdmin(existingAssignmentCircleId());
      allow delete: if false;
    }

    match /progressLogs/{logId} {
      allow read: if isMember(resource.data.circleId);
      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && isMember(request.resource.data.circleId);
      allow update: if signedIn()
        && resource.data.userId == uid()
        && request.resource.data.userId == uid();
      allow delete: if false;
    }
  }
}
